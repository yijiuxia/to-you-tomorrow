    "action": { "enum": ["nod", "shake_head", "wave", "look_down", "chin_rest", "tilt_head", "pout", "cheer", "point", "look_away", "fidget", "none"] },
    "options": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 30 }, "minItems": 3, "maxItems": 3 }
